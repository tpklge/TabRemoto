+static uint32_t *scryptVrow(SCRYPT_V *v, uint64_t row, uint64_t r)
+{ return v->pages[row / v->rows_per_page] + (row % v->rows_per_page) * 32 * r; }
+#else
+typedef uint32_t SCRYPT_V;
+static uint32_t *scryptVrow(SCRYPT_V *v, uint64_t row, uint64_t r)
+{ return v + row * 32 * r; }
+#endif
