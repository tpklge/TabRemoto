--- /dev/null
+++ b/src/wireguard_inner.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+// Validate the decrypted inner packet before reading any IP header field.
+static inline int wireguard_inner_packet(const uint8_t *data,size_t size,
+                                         unsigned *family,uint8_t source[16],
+                                         size_t *length) {
+  if(!data || !size || !family || !source || !length) return 0;
+  memset(source,0,16);
+  *family=data[0]>>4;
+  if(*family==4) {
+    if(size<20 || (data[0]&15)<5 || (size_t)(data[0]&15)*4>size) return 0;
+    *length=((size_t)data[2]<<8)|data[3];
+    if(*length<(size_t)(data[0]&15)*4 || *length>size) return 0;
+    memcpy(source,data+12,4);return 1;
+  }
+  if(*family==6) {
+    if(size<40) return 0;
+    *length=40+(((size_t)data[4]<<8)|data[5]);
+    if(*length>size) return 0;
+    memcpy(source,data+8,16);return 1;
+  }
+  return 0;
+}
